EMAIL_TRANSPORT=mailpit
# Host-side `functions serve`; Kong-routed functions need http://inbucket:8025 (export before `supabase start`).
MAILPIT_URL=http://127.0.0.1:54324
APP_URL=http://127.0.0.1:5173
EMAIL_FROM=Stay In Touch <no-reply@example.test>
MEDIA_PROVIDER=supabase
MEDIA_BUCKET=photos
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:54321
MEDIA_UPLOAD_MAX_BYTES=5242880
# Export MEDIA_CLEANUP_SECRET before `supabase start`. It is not a committed value.
# S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, and S3_SECRET_ACCESS_KEY stay unset
# until MEDIA_PROVIDER is r2 or b2. Those four are secrets and are never committed.