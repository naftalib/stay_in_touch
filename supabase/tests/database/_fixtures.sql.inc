-- Shared fixtures for pgTAP. Included inside each test's transaction.
-- Uses @fixture.test so it never collides with the local seed (@example.test).

create schema if not exists test;

create or replace function test.seed_user(p_id uuid, p_email text, p_name text)
returns void
language plpgsql
security definer
set search_path = ''
as $$
begin
  insert into auth.users (
    instance_id,
    id,
    aud,
    role,
    email,
    encrypted_password,
    email_confirmed_at,
    confirmation_token,
    recovery_token,
    email_change,
    email_change_token_new,
    email_change_token_current,
    reauthentication_token,
    raw_app_meta_data,
    raw_user_meta_data,
    created_at,
    updated_at,
    is_sso_user,
    is_anonymous
  )
  values (
    '00000000-0000-0000-0000-000000000000',
    p_id,
    'authenticated',
    'authenticated',
    p_email,
    extensions.crypt('fixture-only', extensions.gen_salt('bf')),
    pg_catalog.now(),
    '', '', '', '', '', '',
    '{"provider":"email","providers":["email"]}'::jsonb,
    jsonb_build_object('display_name', p_name),
    pg_catalog.now(),
    pg_catalog.now(),
    false,
    false
  );
end;
$$;

-- Sets the JWT claims the policies read. The caller still does
-- `set local role authenticated` once; switching users is another login().
create or replace function test.login(p_email text)
returns void
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_id uuid;
begin
  select u.id into v_id from auth.users u where u.email = p_email;
  if v_id is null then
    raise exception 'no fixture user %', p_email;
  end if;

  perform set_config('request.jwt.claim.sub', v_id::text, true);
  perform set_config('request.jwt.claim.role', 'authenticated', true);
  perform set_config(
    'request.jwt.claims',
    json_build_object(
      'sub', v_id::text,
      'role', 'authenticated',
      'email', p_email
    )::text,
    true
  );
end;
$$;

revoke all on function test.seed_user(uuid, text, text) from public;
revoke all on function test.login(text) from public;
grant usage on schema test to anon, authenticated;
grant execute on function test.login(text) to anon, authenticated;

