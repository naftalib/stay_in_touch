{
  "name": "stay-in-touch",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --fail-on error && supabase db advisors --type security --level warn --fail-on warn",
    "db:types": "supabase gen types typescript --local > web/src/lib/database.types.ts && pnpm exec oxfmt web/src/lib/database.types.ts",
    "push:keys": "deno run --allow-net --allow-env --allow-read --allow-write --allow-run scripts/push-keys.ts",
    "bootstrap:family": "deno run --node-modules-dir=none --allow-net --allow-env --allow-read --allow-run scripts/bootstrap-family.ts",
    "post-deploy-check": "deno run --allow-net scripts/post-deploy-check.ts",
    "storage-check": "bash scripts/storage-check.sh",
    "test": "pnpm --filter web test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:pwa": "pnpm --filter web test:e2e:pwa",
    "test:push:real": "pnpm --filter web test:push:real"
  },
  "devDependencies": {
    "oxfmt": "0.78.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
