# Names only. Copy to .env (gitignored) and fill from `supabase status` after
# `supabase start`. Never put a secret or service-role key in a VITE_ variable.

# Local API URL, usually http://127.0.0.1:54321
VITE_SUPABASE_URL=

# Publishable (anon) key. Safe to ship in the frontend. RLS still applies.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Not used yet. Later handoffs.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# RESEND_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
