# Names only. Copy to .env (gitignored) and fill from `supabase status` after
# `supabase start`. Never put a secret or service-role key in a VITE_ variable.

# Local API URL, usually http://127.0.0.1:54321
VITE_SUPABASE_URL=

# Publishable (anon) key. Safe to ship in the frontend. RLS still applies.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Generate a local pair with `pnpm push:keys`. The private key stays in gitignored files.
# VITE_VAPID_PUBLIC_KEY is the raw key the browser passes to PushManager.subscribe.
# VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are base64url-encoded JWK JSON for the Edge Function.
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.test
# PUSH_TRANSPORT=capture
# PUSH_SEND_SECRET is exported in the shell before `supabase start`. Do not commit it.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# RESEND_API_KEY=
